---
const { title = "Tunes" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Fiddle tune practice list and trainer" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color: #222;
    background: #f6f6ef;
    font-family: "Courier New", Courier, monospace;
    font-size: 16px;
    line-height: 1.4;
    text-rendering: optimizeSpeed;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: #f6f6ef;
    color: #222;
  }

  main {
    margin: 0 auto;
    max-width: 960px;
    padding: 0.75rem 0.75rem 2rem;
  }

  h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0 0 0.25rem;
  }

  h2 {
    font-size: 1.125rem;
    margin: 0;
  }

  h3 {
    font-size: 1rem;
    margin: 0;
  }

  .eyebrow {
    color: #828282;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0 0 0.2rem;
    text-transform: uppercase;
  }

  a {
    color: #0000ee;
    text-decoration: underline;
  }

  ul {
    padding-left: 1.5rem;
  }

  hr {
    border: 0;
    border-top: 1px solid #d6d0c4;
    margin: 1rem 0;
  }

  button,
  input {
    font: inherit;
  }

  ::selection {
    background: #ff6600;
    color: #fff;
  }
</style>
