---
const { title = "Tunes" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Fiddle tune practice list and trainer" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color: #f2f4ea;
    background:
      radial-gradient(circle at top left, rgba(75, 184, 129, 0.2), transparent 28rem),
      radial-gradient(circle at 85% 12%, rgba(225, 150, 72, 0.16), transparent 24rem),
      linear-gradient(135deg, #07110d 0%, #101610 48%, #17120d 100%);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.5;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  main {
    margin: 0 auto;
    max-width: 1180px;
    padding: 2rem 1rem 4rem;
  }

  h1 {
    font-size: clamp(2.25rem, 4vw, 4.75rem);
    line-height: 1.1;
    letter-spacing: 0;
    margin: 0;
  }

  h2 {
    font-size: 1.25rem;
    letter-spacing: 0;
    margin: 0;
  }

  h3 {
    font-size: 1.15rem;
  }

  .eyebrow {
    color: #a9cdb2;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    margin: 0 0 0.25rem;
    text-transform: uppercase;
  }

  a {
    color: #8be0ad;
    text-underline-offset: 0.16em;
  }

  ul {
    padding-left: 1.5rem;
  }

  hr {
    border: 0;
    border-top: 1px solid rgba(242, 244, 234, 0.12);
    margin: 1.5rem 0;
  }

  button,
  input {
    font: inherit;
  }

  ::selection {
    background: #2d694a;
    color: #fff;
  }

  @media (min-width: 760px) {
    main {
      padding: 3rem 1.5rem 5rem;
    }
  }
</style>
