      linear-gradient(135deg, rgba(7, 17, 13, 0.96), rgba(20, 33, 24, 0.94));
    border: 1px solid rgba(214, 237, 218, 0.12);
    border-radius: 8px;
    color: #fff;
    min-height: 10rem;
    padding: 1rem;
  }

  .tune-preview {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(214, 237, 218, 0.12);
