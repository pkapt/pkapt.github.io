<section class="trainer-shell" aria-labelledby="tune-trainer-title">
  <div class="trainer-copy">
    <p class="eyebrow">Spaced-ish repetition</p>
    <h2 id="tune-trainer-title">Practice Queue</h2>
    <p class="trainer-copy__note">Unrated and shaky tunes surface more often. Good tunes still loop back occasionally.</p>
  </div>

  <div class="trainer-queue">
    <div class="trainer-board__top">
      <button id="tune-trainer-pick" class="primary-action" type="button">Get Tune</button>
      <button id="tune-trainer-reset" class="ghost-action" type="button">Reset</button>
    </div>

    <div id="tune-trainer-card" class="practice-card" hidden>
      <span id="tune-trainer-label" class="practice-card__label">Next up</span>
      <a id="tune-trainer-link" href="" target="_blank" rel="noopener noreferrer"></a>
      <div class="tune-trainer__rating" aria-label="Rate this tune">
        <button type="button" data-rating="1">1 Good</button>
        <button type="button" data-rating="2">2 OK</button>
        <button type="button" data-rating="3">3 Needs Work</button>
      </div>
    </div>

    <div id="tune-trainer-empty" class="practice-card practice-card--empty">
      <span class="practice-card__label">Ready</span>
      <p>Press Get Tune to pull from the deck.</p>
    </div>
  </div>

  <div class="trainer-tools">
    <div class="practice-timer" aria-labelledby="practice-timer-title">
      <div class="practice-timer__header">
        <div>
          <span class="practice-card__label">Timer</span>
          <h3 id="practice-timer-title">Practice Block</h3>
        </div>
        <label class="practice-timer__duration">
          <span>Minutes</span>
          <input id="practice-timer-minutes" type="number" min="1" max="180" step="1" value="20" />
        </label>
      </div>
      <div id="practice-timer-display" class="practice-timer__display" aria-live="polite">20:00</div>
      <div class="practice-timer__actions">
        <button id="practice-timer-start" class="primary-action" type="button">Start</button>
        <button id="practice-timer-reset" class="ghost-action" type="button">Reset</button>
      </div>
    </div>

    <div class="metronome" aria-labelledby="metronome-title">
      <div class="metronome__header">
        <div>
          <span class="practice-card__label">Metronome</span>
          <h3 id="metronome-title">Tempo</h3>
        </div>
        <label class="metronome__bpm">
          <span>BPM</span>
          <input id="metronome-bpm" type="number" min="30" max="260" step="1" value="100" />
        </label>
      </div>
      <div class="metronome__actions">
        <button id="metronome-start" class="primary-action" type="button">Start</button>
        <span id="metronome-status" class="metronome__status">100 BPM</span>
      </div>
    </div>
  </div>

  <div class="trainer-metrics" aria-label="Rating progress">
    <div class="metric metric--good">
      <span id="metric-good">0</span>
      <p>Good</p>
    </div>
    <div class="metric metric--ok">
      <span id="metric-ok">0</span>
      <p>OK</p>
    </div>
    <div class="metric metric--work">
      <span id="metric-work">0</span>
      <p>Needs Work</p>
    </div>
    <div class="metric metric--unrated">
      <span id="metric-unrated">0</span>
      <p>Unrated</p>
    </div>
  </div>

  <div class="progress-strip" aria-hidden="true">
    <span id="progress-good"></span>
    <span id="progress-ok"></span>
    <span id="progress-work"></span>
  </div>
  <p id="tune-trainer-status" class="tune-trainer__status"></p>
</section>

<script>
  const storageKey = "pkapt-tune-trainer-ratings-v1";
  const tunes = Array.from(document.querySelectorAll<HTMLAnchorElement>("#tunes-list a")).map((link) => ({
    name: link.textContent?.trim() ?? "",
    href: link.href
  }));

  const pickButton = document.getElementById("tune-trainer-pick");
  const resetButton = document.getElementById("tune-trainer-reset");
  const card = document.getElementById("tune-trainer-card");
  const emptyCard = document.getElementById("tune-trainer-empty");
  const tuneLink = document.getElementById("tune-trainer-link") as HTMLAnchorElement | null;
  const status = document.getElementById("tune-trainer-status");
  const label = document.getElementById("tune-trainer-label");
  const metricGood = document.getElementById("metric-good");
  const metricOk = document.getElementById("metric-ok");
  const metricWork = document.getElementById("metric-work");
  const metricUnrated = document.getElementById("metric-unrated");
  const progressGood = document.getElementById("progress-good");
  const progressOk = document.getElementById("progress-ok");
  const progressWork = document.getElementById("progress-work");
  const timerMinutesInput = document.getElementById("practice-timer-minutes") as HTMLInputElement | null;
  const timerDisplay = document.getElementById("practice-timer-display");
  const timerStartButton = document.getElementById("practice-timer-start");
  const timerResetButton = document.getElementById("practice-timer-reset");
  const metronomeBpmInput = document.getElementById("metronome-bpm") as HTMLInputElement | null;
  const metronomeStartButton = document.getElementById("metronome-start");
  const metronomeStatus = document.getElementById("metronome-status");
  let currentTune: { name: string; href: string } | null = null;
  let timerSeconds = 20 * 60;
  let timerId: number | null = null;
  let audioContext: AudioContext | null = null;
  let metronomeId: number | null = null;

  function loadRatings(): Record<string, number> {
    try {
      return JSON.parse(localStorage.getItem(storageKey) ?? "{}");
    } catch {
      return {};
    }
  }

  function saveRatings(ratings: Record<string, number>) {
    localStorage.setItem(storageKey, JSON.stringify(ratings));
    window.dispatchEvent(new CustomEvent("tune-ratings-changed"));
  }

  function getWeight(tune: { name: string }, ratings: Record<string, number>) {
    const rating = Number(ratings[tune.name]);
    if (rating === 1) return 1;
    if (rating === 2) return 3;
    if (rating === 3) return 7;
    return 9;
  }

  function pickWeightedTune() {
    const ratings = loadRatings();
    const weightedTunes = tunes.map((tune) => ({
      tune,
      weight: getWeight(tune, ratings)
    }));
    const totalWeight = weightedTunes.reduce((sum, item) => sum + item.weight, 0);
    let target = Math.random() * totalWeight;

    for (const item of weightedTunes) {
      target -= item.weight;
      if (target <= 0) {
        return item.tune;
      }
    }

    return tunes[tunes.length - 1];
  }

  function updateStatus() {
    const ratings = loadRatings();
    const counts: Record<number, number> = { 1: 0, 2: 0, 3: 0 };
    const knownTuneNames = new Set(tunes.map((tune) => tune.name));
    const ratedNames = Object.keys(ratings).filter((name) => knownTuneNames.has(name));

    ratedNames.forEach((name) => {
      const rating = ratings[name];
      if (counts[rating] !== undefined) {
        counts[rating] += 1;
      }
    });

    const unrated = tunes.length - ratedNames.length;
    const rated = ratedNames.length;
    const goodPct = tunes.length ? (counts[1] / tunes.length) * 100 : 0;
    const okPct = tunes.length ? (counts[2] / tunes.length) * 100 : 0;
    const workPct = tunes.length ? (counts[3] / tunes.length) * 100 : 0;

    if (metricGood) metricGood.textContent = String(counts[1]);
    if (metricOk) metricOk.textContent = String(counts[2]);
    if (metricWork) metricWork.textContent = String(counts[3]);
    if (metricUnrated) metricUnrated.textContent = String(unrated);
    if (progressGood) progressGood.style.width = `${goodPct}%`;
    if (progressOk) progressOk.style.width = `${okPct}%`;
    if (progressWork) progressWork.style.width = `${workPct}%`;

    if (status) {
      status.textContent = `${rated} of ${tunes.length} rated. The deck is weighted toward unrated and needs-work tunes.`;
    }

    window.dispatchEvent(new CustomEvent("tune-ratings-changed"));
  }

  function showTune(tune: { name: string; href: string }) {
    currentTune = tune;
    if (!tuneLink || !card || !emptyCard) return;

    const ratings = loadRatings();
    const rating = ratings[tune.name];

    tuneLink.textContent = tune.name;
    tuneLink.href = tune.href;
    if (label) label.textContent = rating ? `Current rating: ${rating}` : "Unrated";
    card.hidden = false;
    emptyCard.hidden = true;
  }

  function formatTime(totalSeconds: number) {
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;
    return `${minutes}:${String(seconds).padStart(2, "0")}`;
  }

  function getSelectedSeconds() {
    const minutes = Number(timerMinutesInput?.value);
    const boundedMinutes = Math.min(Math.max(Number.isFinite(minutes) ? minutes : 20, 1), 180);
    if (timerMinutesInput) timerMinutesInput.value = String(boundedMinutes);
    return Math.round(boundedMinutes * 60);
  }

  function updateTimerDisplay() {
    if (timerDisplay) timerDisplay.textContent = formatTime(timerSeconds);
  }

  function stopTimer() {
    if (timerId === null) return;
    window.clearInterval(timerId);
    timerId = null;
    if (timerStartButton) timerStartButton.textContent = "Start";
    if (timerMinutesInput) timerMinutesInput.disabled = false;
  }

  function resetTimer() {
    stopTimer();
    timerSeconds = getSelectedSeconds();
    updateTimerDisplay();
  }

  function startTimer() {
    if (timerId !== null) {
      stopTimer();
      return;
    }

    if (timerSeconds <= 0) {
      timerSeconds = getSelectedSeconds();
      updateTimerDisplay();
    }

    if (timerStartButton) timerStartButton.textContent = "Pause";
    if (timerMinutesInput) timerMinutesInput.disabled = true;
    timerId = window.setInterval(() => {
      timerSeconds -= 1;
      updateTimerDisplay();

      if (timerSeconds <= 0) {
        timerSeconds = 0;
        updateTimerDisplay();
        stopTimer();
      }
    }, 1000);
  }

  function getSelectedBpm() {
    const bpm = Number(metronomeBpmInput?.value);
    const boundedBpm = Math.min(Math.max(Number.isFinite(bpm) ? bpm : 100, 30), 260);
    if (metronomeBpmInput) metronomeBpmInput.value = String(boundedBpm);
    return boundedBpm;
  }

  function updateMetronomeStatus() {
    const bpm = getSelectedBpm();
    if (metronomeStatus) metronomeStatus.textContent = metronomeId === null ? `${bpm} BPM` : `Playing ${bpm} BPM`;
  }

  function playMetronomeClick() {
    audioContext ??= new AudioContext();
    const startTime = audioContext.currentTime;
    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();

    oscillator.type = "square";
    oscillator.frequency.setValueAtTime(1200, startTime);
    gain.gain.setValueAtTime(0.0001, startTime);
    gain.gain.exponentialRampToValueAtTime(0.35, startTime + 0.002);
    gain.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.045);

    oscillator.connect(gain);
    gain.connect(audioContext.destination);
    oscillator.start(startTime);
    oscillator.stop(startTime + 0.05);
  }

  function stopMetronome() {
    if (metronomeId !== null) {
      window.clearInterval(metronomeId);
      metronomeId = null;
    }

    if (metronomeStartButton) metronomeStartButton.textContent = "Start";
    updateMetronomeStatus();
  }

  function startMetronome() {
    if (metronomeId !== null) {
      stopMetronome();
      return;
    }

    const bpm = getSelectedBpm();
    const intervalMs = Math.round(60000 / bpm);
    playMetronomeClick();
    metronomeId = window.setInterval(playMetronomeClick, intervalMs);

    if (metronomeStartButton) metronomeStartButton.textContent = "Stop";
    updateMetronomeStatus();
  }

  pickButton?.addEventListener("click", () => {
    const tune = pickWeightedTune();
    if (tune) showTune(tune);
  });

  card?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const rating = target.getAttribute("data-rating");
    if (!rating || !currentTune) return;

    const ratings = loadRatings();
    ratings[currentTune.name] = Number(rating);
    saveRatings(ratings);
    updateStatus();

    const tune = pickWeightedTune();
    if (tune) showTune(tune);
  });

  resetButton?.addEventListener("click", () => {
    if (!window.confirm("Clear all saved tune ratings in this browser?")) return;
    localStorage.removeItem(storageKey);
    if (card) card.hidden = true;
    if (emptyCard) emptyCard.hidden = false;
    currentTune = null;
    updateStatus();
  });

  timerMinutesInput?.addEventListener("change", resetTimer);
  timerStartButton?.addEventListener("click", startTimer);
  timerResetButton?.addEventListener("click", resetTimer);
  metronomeBpmInput?.addEventListener("change", () => {
    const wasPlaying = metronomeId !== null;
    if (wasPlaying) stopMetronome();
    updateMetronomeStatus();
    if (wasPlaying) startMetronome();
  });
  metronomeStartButton?.addEventListener("click", startMetronome);
  updateTimerDisplay();
  updateMetronomeStatus();
  updateStatus();
</script>

