    border: 1px solid #8be0ad;
    color: #07110d;
    flex: 1;
  }

  .ghost-action {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(214, 237, 218, 0.16);
    color: #d4e3d2;
  }

  .practice-card {
    background:
      linear-gradient(135deg, rgba(7, 17, 13, 0.96), rgba(20, 33, 24, 0.94));
    border: 1px solid rgba(214, 237, 218, 0.12);
    border-radius: 8px;
    color: #fff;
    min-height: 10rem;
    padding: 1rem;
  }

  .practice-card--empty {
    background: rgba(255, 255, 255, 0.055);
    color: #b7c6b7;
  }

  .practice-card__label {
    color: #9edfb7;
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
