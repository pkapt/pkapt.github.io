    display: inline-block;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 850;
    line-height: 1.05;
    margin: 0.35rem 0 1rem;
    text-decoration: none;
  }

  .practice-card--empty p {
    font-size: 1.15rem;
    margin: 0.4rem 0 0;
  }

  .tune-trainer__rating {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tune-trainer__rating button {
