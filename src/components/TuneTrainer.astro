  }

  .primary-action {
    background: #8be0ad;
    border: 1px solid #8be0ad;
    color: #07110d;
    flex: 1;
  }

  .ghost-action {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(214, 237, 218, 0.16);
    color: #d4e3d2;
  }

  .practice-card {
