  }

  .metric span {
    display: block;
    font-size: 1.55rem;
    font-weight: 850;
    line-height: 1;
  }

  .metric p {
    color: #a7b8a9;
    font-size: 0.78rem;
    font-weight: 760;
    margin: 0.24rem 0 0;
    text-transform: uppercase;
  }

  .metric--good span {
    color: #91eba0;
  }

  .metric--ok span {
    color: #f0d076;
  }

  .metric--work span {
    color: #ff9f8e;
  }

  .progress-strip {
    background: rgba(255, 255, 255, 0.09);
    border-radius: 999px;
    display: flex;
    height: 0.6rem;
    overflow: hidden;
  }

  .progress-strip span {
    display: block;
    transition: width 220ms ease;
    width: 0;
  }

  #progress-good {
    background: #72d985;
  }

  #progress-ok {
    background: #e9c75e;
  }

  #progress-work {
    background: #ef765b;
  }

  .tune-trainer__status {
    color: #a7b8a9;
    margin: 0;
  }

  @media (min-width: 860px) {
