  }

  .trainer-metrics {
    display: grid;
    gap: 0.55rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .metric {
    background: rgba(255, 255, 255, 0.065);
    border: 1px solid rgba(214, 237, 218, 0.12);
