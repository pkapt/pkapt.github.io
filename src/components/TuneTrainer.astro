      grid-template-columns: minmax(0, 0.95fr) minmax(22rem, 1.15fr);
      padding: 1.25rem;
    }

    .trainer-metrics,
    .progress-strip,
    .tune-trainer__status {
      grid-column: 1 / -1;
    }

    .trainer-metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
