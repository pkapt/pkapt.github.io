      linear-gradient(135deg, rgba(17, 28, 22, 0.92), rgba(20, 24, 19, 0.84)),
      radial-gradient(circle at 82% 16%, rgba(225, 150, 72, 0.2), transparent 22rem),
      radial-gradient(circle at 18% 20%, rgba(74, 184, 129, 0.18), transparent 20rem);
    border: 1px solid rgba(214, 237, 218, 0.14);
    border-radius: 8px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 1rem;
  }

  .trainer-queue {
    display: grid;
    gap: 0.8rem;
  }

  .trainer-board__top {
    display: grid;
  }

  .trainer-board__actions {
    display: flex;
    flex: 1;
    gap: 0.55rem;
  }

