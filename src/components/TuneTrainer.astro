    margin: 0.65rem 0 0;
    max-width: 34rem;
  }

  .trainer-board {
    display: grid;
    gap: 0.8rem;
  }

  .trainer-board__top {
    display: flex;
    gap: 0.55rem;
  }

  .primary-action,
  .ghost-action,
  .tune-trainer__rating button {
    border-radius: 7px;
    cursor: pointer;
    font-weight: 800;
    min-height: 2.7rem;
    padding: 0.55rem 0.8rem;
  }

  .primary-action {
