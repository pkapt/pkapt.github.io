<section class="trainer-shell" aria-labelledby="tune-trainer-title">
  <div class="trainer-queue">
    <div class="trainer-queue__main">
      <div class="trainer-queue__left">
        <div class="trainer-board__top">
          <div class="trainer-board__actions">
            <button id="tune-trainer-pick" class="primary-action" type="button">Get Tune</button>
            <div class="active-batch" aria-live="polite">
              <span class="active-batch__label">Active</span>
              <strong id="tune-trainer-active-count">4</strong>
            </div>
          </div>
        </div>

        <div id="tune-trainer-card" class="practice-card" hidden>
          <span id="tune-trainer-label" class="practice-card__label">Next up</span>
          <div class="practice-card__header">
            <a id="tune-trainer-link" href="" target="_blank" rel="noopener noreferrer"></a>
            <label class="practice-card__toggle">
              <input id="tune-trainer-deprioritize" type="checkbox" />
              <span>Low prio</span>
            </label>
          </div>
          <div class="tune-trainer__rating" aria-label="Rate this tune">
            <button type="button" data-rating="1">1 Good</button>
            <button type="button" data-rating="2">2 OK</button>
            <button type="button" data-rating="3">3 Needs Work</button>
          </div>
        </div>

        <div id="tune-trainer-empty" class="practice-card practice-card--empty">
          <span class="practice-card__label">Ready</span>
          <p>Press Get Tune to pull from the deck.</p>
        </div>
      </div>

      <div class="trainer-queue__right">
        <div class="active-tunes">
          <span class="practice-card__label">Active Tunes</span>
          <ul id="tune-trainer-active-list" class="active-tunes__list" aria-live="polite"></ul>
        </div>
      </div>
    </div>
  </div>

  <div id="tune-trainer-preview" class="tune-preview" hidden>
    <div class="tune-preview__header">
      <span class="practice-card__label">Chart Preview</span>
      <a id="tune-trainer-preview-link" href="" target="_blank" rel="noopener noreferrer">Open full size</a>
    </div>
    <iframe id="tune-trainer-preview-pdf" class="tune-preview__pdf" title="Tune chart preview" hidden></iframe>
    <img id="tune-trainer-preview-image" class="tune-preview__image" alt="" hidden />
    <p id="tune-trainer-preview-fallback" class="tune-preview__fallback" hidden>
      This tune can’t be embedded here. Use the tune link above to open it.
    </p>
  </div>

  <div class="trainer-metrics" aria-label="Rating progress">
    <div class="metric metric--good">
      <span id="metric-good">0</span>
      <p>Good</p>
    </div>
    <div class="metric metric--ok">
      <span id="metric-ok">0</span>
      <p>OK</p>
    </div>
    <div class="metric metric--work">
      <span id="metric-work">0</span>
      <p>Needs Work</p>
    </div>
    <div class="metric metric--unrated">
      <span id="metric-unrated">0</span>
      <p>Unrated</p>
    </div>
  </div>

  <div class="progress-strip" aria-hidden="true">
    <span id="progress-good"></span>
    <span id="progress-ok"></span>
    <span id="progress-work"></span>
  </div>
  <p id="tune-trainer-status" class="tune-trainer__status"></p>
</section>

<script>
  const storageKey = "pkapt-tune-trainer-ratings-v1";
  const activeBatchStorageKey = "pkapt-tune-trainer-active-batch-v1";
  const deprioritizedStorageKey = "pkapt-tune-trainer-deprioritized-v1";
  const activeBatchSize = 4;
  const tunes = Array.from(document.querySelectorAll<HTMLAnchorElement>("#tunes-list a")).map((link) => ({
    name: link.textContent?.trim() ?? "",
    href: link.href
  }));

  const pickButton = document.getElementById("tune-trainer-pick");
  const resetButton = document.getElementById("tune-trainer-reset");
  const card = document.getElementById("tune-trainer-card");
  const emptyCard = document.getElementById("tune-trainer-empty");
  const tuneLink = document.getElementById("tune-trainer-link") as HTMLAnchorElement | null;
  const deprioritizeInput = document.getElementById("tune-trainer-deprioritize") as HTMLInputElement | null;
  const preview = document.getElementById("tune-trainer-preview");
  const previewLink = document.getElementById("tune-trainer-preview-link") as HTMLAnchorElement | null;
  const previewPdf = document.getElementById("tune-trainer-preview-pdf") as HTMLIFrameElement | null;
  const previewImage = document.getElementById("tune-trainer-preview-image") as HTMLImageElement | null;
  const previewFallback = document.getElementById("tune-trainer-preview-fallback");
  const status = document.getElementById("tune-trainer-status");
  const label = document.getElementById("tune-trainer-label");
  const activeCount = document.getElementById("tune-trainer-active-count");
  const activeList = document.getElementById("tune-trainer-active-list");
  const metricGood = document.getElementById("metric-good");
  const metricOk = document.getElementById("metric-ok");
  const metricWork = document.getElementById("metric-work");
  const metricUnrated = document.getElementById("metric-unrated");
  const progressGood = document.getElementById("progress-good");
  const progressOk = document.getElementById("progress-ok");
  const progressWork = document.getElementById("progress-work");
  let currentTune: { name: string; href: string } | null = null;
  let activeBatch = loadActiveBatch();
  let deprioritizedTunes = loadDeprioritizedTunes();

  function loadRatings(): Record<string, number> {
    try {
      return JSON.parse(localStorage.getItem(storageKey) ?? "{}");
    } catch {
      return {};
    }
  }

  function saveRatings(ratings: Record<string, number>) {
    localStorage.setItem(storageKey, JSON.stringify(ratings));
    window.dispatchEvent(new CustomEvent("tune-ratings-changed"));
  }

  function loadDeprioritizedTunes() {
    try {
      const saved = JSON.parse(localStorage.getItem(deprioritizedStorageKey) ?? "[]");
      const knownTuneNames = new Set(tunes.map((tune) => tune.name));
      if (!Array.isArray(saved)) return [];

      return saved.filter((name, index) =>
        typeof name === "string" &&
        knownTuneNames.has(name) &&
        saved.indexOf(name) === index
      );
    } catch {
      return [];
    }
  }

  function syncDeprioritizeToggle() {
    if (!deprioritizeInput) return;
    deprioritizeInput.checked = currentTune ? deprioritizedTunes.includes(currentTune.name) : false;
    deprioritizeInput.disabled = !currentTune;
  }

  function saveDeprioritizedTunes(names: string[]) {
    deprioritizedTunes = names;
    localStorage.setItem(deprioritizedStorageKey, JSON.stringify(names));
    syncDeprioritizeToggle();
    renderActiveBatchList();
  }

  function pruneDeprioritizedTunes() {
    const nextNames = deprioritizedTunes.filter((name) => activeBatch.includes(name));
    if (nextNames.length === deprioritizedTunes.length) return;
    deprioritizedTunes = nextNames;
    localStorage.setItem(deprioritizedStorageKey, JSON.stringify(nextNames));
  }

  function loadActiveBatch() {
    try {
      const saved = JSON.parse(localStorage.getItem(activeBatchStorageKey) ?? "[]");
      const knownTuneNames = new Set(tunes.map((tune) => tune.name));
      if (!Array.isArray(saved)) return [];

      return saved.filter((name, index) =>
        typeof name === "string" &&
        knownTuneNames.has(name) &&
        saved.indexOf(name) === index
      );
    } catch {
      return [];
    }
  }

  function saveActiveBatch(batch: string[]) {
    activeBatch = batch;
    localStorage.setItem(activeBatchStorageKey, JSON.stringify(batch));
    pruneDeprioritizedTunes();
    updateActiveBatchCount();
    syncDeprioritizeToggle();
    renderActiveBatchList();
  }

  function getWeight(tune: { name: string }, ratings: Record<string, number>) {
    const rating = Number(ratings[tune.name]);
    if (rating === 1) return 1;
    if (rating === 2) return 3;
    if (rating === 3) return 7;
    return 9;
  }

  function pickWeightedTune(excludedNames = new Set<string>()) {
    const ratings = loadRatings();
    const weightedTunes = tunes
      .filter((tune) => !excludedNames.has(tune.name))
      .map((tune) => ({
        tune,
        weight: getWeight(tune, ratings)
      }));

    if (!weightedTunes.length) return null;

    const totalWeight = weightedTunes.reduce((sum, item) => sum + item.weight, 0);
    let target = Math.random() * totalWeight;

    for (const item of weightedTunes) {
      target -= item.weight;
      if (target <= 0) {
        return item.tune;
      }
    }

    return weightedTunes[weightedTunes.length - 1]?.tune ?? null;
  }

  function pickWeightedFromTunes(availableTunes: { name: string; href: string }[]) {
    const ratings = loadRatings();
    const weightedTunes = availableTunes.map((tune) => ({
      tune,
      weight: getWeight(tune, ratings)
    }));

    if (!weightedTunes.length) return null;

    const totalWeight = weightedTunes.reduce((sum, item) => sum + item.weight, 0);
    let target = Math.random() * totalWeight;

    for (const item of weightedTunes) {
      target -= item.weight;
      if (target <= 0) {
        return item.tune;
      }
    }

    return weightedTunes[weightedTunes.length - 1]?.tune ?? null;
  }

  function buildActiveBatch() {
    const nextBatch: string[] = [];
    const targetSize = Math.min(activeBatchSize, tunes.length);

    while (nextBatch.length < targetSize) {
      const lowPrioLocked = !areRegularTunesCleared();
      const excludedNames = new Set([
        ...nextBatch,
        ...(lowPrioLocked ? deprioritizedTunes : [])
      ]);
      const tune = pickWeightedTune(excludedNames);
      if (!tune) break;
      nextBatch.push(tune.name);
    }

    return nextBatch;
  }

  function areRegularTunesCleared() {
    const ratings = loadRatings();

    return tunes
      .filter((tune) => !deprioritizedTunes.includes(tune.name))
      .every((tune) => {
        const rating = Number(ratings[tune.name]);
        return rating === 1 || rating === 2;
      });
  }

  function topUpActiveBatch(batch: string[]) {
    const nextBatch = [...batch];
    const targetSize = Math.min(activeBatchSize, tunes.length);
    const lowPrioLocked = !areRegularTunesCleared();

    while (nextBatch.length < targetSize) {
      const excludedNames = new Set([
        ...nextBatch,
        ...(lowPrioLocked ? deprioritizedTunes : [])
      ]);
      const tune = pickWeightedTune(excludedNames);
      if (!tune) break;
      nextBatch.push(tune.name);
    }

    return nextBatch;
  }

  function ensureActiveBatch() {
    if (activeBatch.length > 0) {
      updateActiveBatchCount();
      return;
    }

    saveActiveBatch(buildActiveBatch());
  }

  function updateActiveBatchCount() {
    if (activeCount) activeCount.textContent = String(activeBatch.length);
  }

  function getPreviewKind(href: string) {
    try {
      const url = new URL(href, window.location.href);
      const pathname = url.pathname.toLowerCase();
      if (pathname.endsWith(".pdf")) return "pdf";
      if (pathname.match(/\.(jpg|jpeg|png|gif|webp)$/)) return "image";
    } catch {
      return "fallback";
    }

    return "fallback";
  }

  function clearPreview() {
    if (preview) preview.hidden = true;
    if (previewLink) previewLink.href = "";
    if (previewPdf) {
      previewPdf.hidden = true;
      previewPdf.src = "";
    }
    if (previewImage) {
      previewImage.hidden = true;
      previewImage.src = "";
      previewImage.alt = "";
    }
    if (previewFallback) previewFallback.hidden = true;
  }

  function updatePreview(tune: { name: string; href: string } | null) {
    if (!tune || !preview) {
      clearPreview();
      return;
    }

    const kind = getPreviewKind(tune.href);
    preview.hidden = false;
    if (previewLink) previewLink.href = tune.href;
    if (previewPdf) {
      previewPdf.hidden = true;
      previewPdf.src = "";
    }
    if (previewImage) {
      previewImage.hidden = true;
      previewImage.src = "";
      previewImage.alt = "";
    }
    if (previewFallback) previewFallback.hidden = true;

    if (kind === "pdf" && previewPdf) {
      previewPdf.src = tune.href;
      previewPdf.hidden = false;
      return;
    }

    if (kind === "image" && previewImage) {
      previewImage.src = tune.href;
      previewImage.alt = `${tune.name} chart preview`;
      previewImage.hidden = false;
      return;
    }

    if (previewFallback) previewFallback.hidden = false;
  }

  function renderActiveBatchList() {
    if (!activeList) return;

    const items = activeBatch
      .map((name) => tunes.find((tune) => tune.name === name))
      .filter((tune): tune is { name: string; href: string } => Boolean(tune))
      .map((tune) => {
        const currentClass = currentTune?.name === tune.name ? " is-current" : "";
        const deprioritizedClass = deprioritizedTunes.includes(tune.name) ? " is-deprioritized" : "";
        const badge = deprioritizedTunes.includes(tune.name)
          ? "<span class=\"active-tunes__badge\">Low prio</span>"
          : "";
        return `<li><a class="active-tunes__link${currentClass}${deprioritizedClass}" href="${tune.href}" target="_blank" rel="noopener noreferrer"><span>${tune.name}</span>${badge}</a></li>`;
      });

    activeList.innerHTML = items.length ? items.join("") : "<li class=\"active-tunes__empty\">No active tunes.</li>";
  }

  function pickFromActiveBatch() {
    ensureActiveBatch();
    let activeTunes = tunes.filter((tune) => activeBatch.includes(tune.name));
    if (!activeTunes.length) return null;

    if (activeTunes.length > 1 && currentTune) {
      const nextOptions = activeTunes.filter((tune) => tune.name !== currentTune.name);
      if (nextOptions.length) activeTunes = nextOptions;
    }

    return pickWeightedFromTunes(activeTunes);
  }

  function updateStatus() {
    const ratings = loadRatings();
    const counts: Record<number, number> = { 1: 0, 2: 0, 3: 0 };
    const knownTuneNames = new Set(tunes.map((tune) => tune.name));
    const ratedNames = Object.keys(ratings).filter((name) => knownTuneNames.has(name));

    ratedNames.forEach((name) => {
      const rating = ratings[name];
      if (counts[rating] !== undefined) {
        counts[rating] += 1;
      }
    });

    const unrated = tunes.length - ratedNames.length;
    const rated = ratedNames.length;
    const goodPct = tunes.length ? (counts[1] / tunes.length) * 100 : 0;
    const okPct = tunes.length ? (counts[2] / tunes.length) * 100 : 0;
    const workPct = tunes.length ? (counts[3] / tunes.length) * 100 : 0;

    if (metricGood) metricGood.textContent = String(counts[1]);
    if (metricOk) metricOk.textContent = String(counts[2]);
    if (metricWork) metricWork.textContent = String(counts[3]);
    if (metricUnrated) metricUnrated.textContent = String(unrated);
    if (progressGood) progressGood.style.width = `${goodPct}%`;
    if (progressOk) progressOk.style.width = `${okPct}%`;
    if (progressWork) progressWork.style.width = `${workPct}%`;

    if (status) {
      const batchNote = activeBatch.length
        ? `${activeBatch.length} tune${activeBatch.length === 1 ? "" : "s"} active in this batch.`
        : "A new batch will start on your next tune.";
      status.textContent = `${rated} of ${tunes.length} rated. The deck is weighted toward unrated and needs-work tunes. ${batchNote}`;
    }

    window.dispatchEvent(new CustomEvent("tune-ratings-changed"));
  }

  function showTune(tune: { name: string; href: string }) {
    currentTune = tune;
    if (!tuneLink || !card || !emptyCard) return;

    const ratings = loadRatings();
    const rating = ratings[tune.name];

    tuneLink.textContent = tune.name;
    tuneLink.href = tune.href;
    if (label) label.textContent = rating ? `Current rating: ${rating}` : "Unrated";
    card.hidden = false;
    emptyCard.hidden = true;
    syncDeprioritizeToggle();
    renderActiveBatchList();
    updatePreview(tune);
  }

  pickButton?.addEventListener("click", () => {
    const tune = pickFromActiveBatch();
    if (tune) showTune(tune);
  });

  card?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const rating = target.getAttribute("data-rating");
    if (!rating || !currentTune) return;

    const ratings = loadRatings();
    ratings[currentTune.name] = Number(rating);
    saveRatings(ratings);

    if (Number(rating) <= 2) {
      saveActiveBatch(activeBatch.filter((name) => name !== currentTune?.name));
    } else {
      updateActiveBatchCount();
      syncDeprioritizeToggle();
      renderActiveBatchList();
    }

    updateStatus();

    const tune = pickFromActiveBatch();
    if (tune) showTune(tune);
  });

  resetButton?.addEventListener("click", () => {
    if (!window.confirm("Clear all saved tune ratings in this browser?")) return;
    localStorage.removeItem(storageKey);
    localStorage.removeItem(activeBatchStorageKey);
    localStorage.removeItem(deprioritizedStorageKey);
    if (card) card.hidden = true;
    if (emptyCard) emptyCard.hidden = false;
    currentTune = null;
    activeBatch = [];
    deprioritizedTunes = [];
    updateStatus();
    updateActiveBatchCount();
    syncDeprioritizeToggle();
    renderActiveBatchList();
    clearPreview();
  });

  deprioritizeInput?.addEventListener("change", () => {
    if (!currentTune) return;

    if (deprioritizeInput.checked) {
      if (!deprioritizedTunes.includes(currentTune.name)) {
        saveDeprioritizedTunes([...deprioritizedTunes, currentTune.name]);
        saveActiveBatch(topUpActiveBatch(activeBatch.filter((name) => name !== currentTune.name)));
      }
      return;
    }

    saveDeprioritizedTunes(deprioritizedTunes.filter((name) => name !== currentTune.name));
  });

  ensureActiveBatch();
  syncDeprioritizeToggle();
  updateStatus();
</script>

