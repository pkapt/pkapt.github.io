---
import TuneTrainer from "./TuneTrainer.astro";
import { backingTracks, transcriptions, tunes } from "../data/tunes";

const localChartCount = tunes.filter((tune) => tune.href.startsWith("/assets/")).length;
const videoCount = tunes.filter((tune) => tune.href.includes("youtube.com")).length;
const webCount = tunes.length - localChartCount - videoCount;

function resourceLabel(href: string) {
  if (href.includes("youtube.com")) return "video";
  if (href.startsWith("file:")) return "local file";
  if (href.startsWith("/assets/")) return href.toLowerCase().match(/\.(jpg|jpeg|png)$/) ? "image" : "chart";
  return "web";
}

function resourceKind(href: string) {
  if (href.includes("youtube.com")) return "video";
  if (href.startsWith("/assets/")) return "chart";
  return "web";
}
---

<section class="hero" aria-labelledby="page-title">
  <div class="hero__text">
    <p class="eyebrow">Practice deck</p>
    <h1 id="page-title">Tunes</h1>
  </div>
  <div class="hero__stats" aria-label="Repertoire summary">
    <div>
      <strong>{tunes.length}</strong>
      <span>tunes</span>
    </div>
    <div>
      <strong>{localChartCount}</strong>
      <span>local charts</span>
    </div>
    <div>
      <strong>{videoCount + webCount}</strong>
      <span>outside links</span>
    </div>
  </div>
</section>

<TuneTrainer />

<section class="library" aria-labelledby="tunes-heading">
  <div class="library__top">
    <div>
      <p class="eyebrow">Repertoire</p>
      <h2 id="tunes-heading">Tune Library</h2>
    </div>
    <div class="library__tools">
      <input id="tune-search" type="search" placeholder="Search tunes" aria-label="Search tunes" />
      <div class="filter-tabs" aria-label="Filter tunes">
        <button class="is-active" type="button" data-filter="all">All</button>
        <button type="button" data-filter="unrated">Unrated</button>
        <button type="button" data-filter="3">Needs Work</button>
        <button type="button" data-filter="2">OK</button>
        <button type="button" data-filter="1">Good</button>
      </div>
    </div>
  </div>

  <div id="tunes-list" class="tune-grid">
    {tunes.map((tune) => (
      <article class="tune-card" data-tune-card data-name={tune.name} data-kind={resourceKind(tune.href)}>
        <div>
          <a href={tune.href}>{tune.name}</a>
          <p>{resourceLabel(tune.href)}</p>
        </div>
        <span class="rating-pill" data-rating-pill>unrated</span>
      </article>
    ))}
  </div>
  <p id="empty-library-message" class="empty-message" hidden>No tunes match that filter.</p>
</section>

<section class="utility-grid" aria-label="Practice resources">
  <article class="panel">
    <div class="panel__header">
      <h2>Backing Tracks</h2>
      <span>{backingTracks.length}</span>
    </div>
    <div class="track-buttons">
      {backingTracks.map((track) => <a class="track-button" href={track.href}>{track.name}</a>)}
    </div>
  </article>

  <article class="panel">
    <div class="panel__header">
      <h2>Transcriptions</h2>
      <span>{transcriptions.length}</span>
    </div>
    <div class="link-stack">
      {transcriptions.map((transcription) => (
        <a href={transcription.href}>
          <span>{transcription.name}</span>
          <small>{resourceLabel(transcription.href)}</small>
        </a>
      ))}
    </div>
  </article>
</section>

<script>
  const storageKey = "pkapt-tune-trainer-ratings-v1";
  const searchInput = document.getElementById("tune-search") as HTMLInputElement | null;
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-tune-card]"));
  const emptyMessage = document.getElementById("empty-library-message");
  let activeFilter = "all";

  function loadRatings(): Record<string, number> {
    try {
      return JSON.parse(localStorage.getItem(storageKey) ?? "{}");
    } catch {
      return {};
    }
  }

  function labelForRating(rating?: number) {
    if (rating === 1) return "good";
    if (rating === 2) return "ok";
    if (rating === 3) return "needs work";
    return "unrated";
  }

  function syncLibrary() {
    const ratings = loadRatings();
    const query = searchInput?.value.trim().toLowerCase() ?? "";
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.dataset.name ?? "";
      const rating = ratings[name];
      const matchesSearch = name.toLowerCase().includes(query);
      const matchesFilter =
        activeFilter === "all" ||
        (activeFilter === "unrated" && !rating) ||
        String(rating) === activeFilter;

      const pill = card.querySelector<HTMLElement>("[data-rating-pill]");
      if (pill) {
        pill.textContent = labelForRating(rating);
        pill.dataset.rating = rating ? String(rating) : "unrated";
      }

      card.dataset.rating = rating ? String(rating) : "unrated";
      card.hidden = !(matchesSearch && matchesFilter);
      if (!card.hidden) visibleCount += 1;
    });

    if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
  }

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeFilter = button.dataset.filter ?? "all";
      filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      syncLibrary();
    });
  });

  searchInput?.addEventListener("input", syncLibrary);
  window.addEventListener("tune-ratings-changed", syncLibrary);
  syncLibrary();
</script>

<style>
  .hero {
    align-items: end;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    margin-bottom: 1.25rem;
  }

  .hero__stats {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hero__stats div,
  .panel,
  .library {
    background: rgba(18, 27, 21, 0.82);
    border: 1px solid rgba(214, 237, 218, 0.13);
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(14px);
  }

  .hero__stats div {
    border-radius: 8px;
    padding: 0.8rem;
  }

  .hero__stats strong {
    display: block;
    font-size: 1.55rem;
    line-height: 1;
  }

  .hero__stats span {
    color: #a7b8a9;
    display: block;
    font-size: 0.8rem;
    margin-top: 0.25rem;
  }

  .utility-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin: 1rem 0;
  }

  .panel,
  .library {
    border-radius: 8px;
    padding: 1rem;
  }

  .panel__header,
  .library__top {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .panel__header span {
    background: rgba(136, 219, 165, 0.14);
    border-radius: 999px;
    color: #a4e6ba;
    font-size: 0.82rem;
    font-weight: 750;
    padding: 0.22rem 0.55rem;
  }

  .track-buttons {
    display: grid;
    gap: 0.55rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .track-button,
  .link-stack a {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(214, 237, 218, 0.12);
    border-radius: 7px;
    color: #ecf4e8;
    font-weight: 700;
    padding: 0.7rem;
    text-decoration: none;
  }

  .track-button:hover,
  .link-stack a:hover,
  .tune-card:hover {
    border-color: rgba(30, 104, 77, 0.42);
    background: rgba(136, 219, 165, 0.1);
    transform: translateY(-1px);
  }

  .link-stack {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .link-stack a {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .link-stack small {
    color: #a7b8a9;
    font-weight: 650;
  }

  .library {
    margin-top: 1rem;
  }

  .library__top {
    align-items: start;
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .library__tools {
    display: grid;
    gap: 0.7rem;
    width: 100%;
  }

  #tune-search {
    background: rgba(6, 12, 9, 0.72);
    border: 1px solid rgba(214, 237, 218, 0.18);
    border-radius: 8px;
    color: #f2f4ea;
    padding: 0.7rem 0.8rem;
    width: 100%;
  }

  #tune-search::placeholder {
    color: #89988d;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .filter-tabs button {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid transparent;
    border-radius: 999px;
    color: #c5d1c1;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 750;
    padding: 0.45rem 0.7rem;
  }

  .filter-tabs button.is-active {
    background: #8be0ad;
    color: #07110d;
  }

  .tune-grid {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: 1fr;
  }

  .tune-card {
    align-items: center;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(214, 237, 218, 0.1);
    border-radius: 8px;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    min-height: 4.2rem;
    padding: 0.8rem;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .tune-card a {
    color: #f2f4ea;
    font-weight: 760;
    text-decoration: none;
  }

  .tune-card p {
    color: #95a499;
    font-size: 0.82rem;
    margin: 0.15rem 0 0;
    text-transform: capitalize;
  }

  .rating-pill {
    border-radius: 999px;
    flex: 0 0 auto;
    font-size: 0.74rem;
    font-weight: 800;
    padding: 0.32rem 0.52rem;
    text-transform: uppercase;
  }

  .rating-pill[data-rating="1"] {
    background: rgba(113, 217, 132, 0.18);
    color: #91eba0;
  }

  .rating-pill[data-rating="2"] {
    background: rgba(241, 199, 86, 0.18);
    color: #f0d076;
  }

  .rating-pill[data-rating="3"] {
    background: rgba(238, 118, 91, 0.2);
    color: #ff9f8e;
  }

  .rating-pill[data-rating="unrated"] {
    background: rgba(255, 255, 255, 0.09);
    color: #b6c3b6;
  }

  .empty-message {
    color: #a7b8a9;
    margin: 1rem 0 0;
  }

  @media (min-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    }

    .utility-grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }

    .library__top {
      align-items: end;
      flex-direction: row;
    }

    .library__tools {
      justify-items: end;
      max-width: 34rem;
    }

    .tune-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .tune-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
