---
import PracticeTools from "./PracticeTools.astro";
import TuneTrainer from "./TuneTrainer.astro";
import { backingTracks, songs, transcriptions, tunes } from "../data/tunes";

function resourceLabel(href: string) {
  if (href.includes("youtube.com")) return "video";
  if (href.startsWith("file:")) return "local file";
  if (href.startsWith("/assets/")) return href.toLowerCase().match(/\.(jpg|jpeg|png)$/) ? "image" : "chart";
  return "web";
}

function resourceKind(href: string) {
  if (href.includes("youtube.com")) return "video";
  if (href.startsWith("/assets/")) return "chart";
  return "web";
}
---

<section class="hero" aria-labelledby="page-title">
  <div class="hero__text">
    <p class="eyebrow">Practice deck</p>
    <div class="hero__title-row">
      <h1 id="page-title">Songs</h1>
      <label class="hero__select-wrap" for="library-mode">
        <span class="hero__select-label">Library</span>
        <select id="library-mode" class="hero__select" aria-label="Choose library view">
          <option value="songs" selected>Songs</option>
          <option value="tunes">Tunes</option>
        </select>
      </label>
    </div>
  </div>
</section>

<TuneTrainer />
<PracticeTools />

<section
  id="tune-library"
  class="library"
  aria-labelledby="tunes-heading"
  data-collapsed="true"
>
  <div class="library__top">
    <div>
      <p class="eyebrow">Repertoire</p>
      <h2 id="tunes-heading">Tune Library</h2>
    </div>
    <button
      id="library-toggle"
      class="library-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="library-content"
    >
      Show Library
    </button>
  </div>

  <div id="library-content" class="library__content">
    <div class="library__tools">
      <input id="tune-search" type="search" placeholder="Search tunes" aria-label="Search tunes" />
      <div class="filter-tabs" aria-label="Filter tunes">
        <button class="is-active" type="button" data-filter="all">All</button>
        <button type="button" data-filter="unrated">Unrated</button>
        <button type="button" data-filter="3">Needs Work</button>
        <button type="button" data-filter="2">OK</button>
        <button type="button" data-filter="1">Good</button>
      </div>
    </div>

    <div id="tunes-list" class="tune-grid">
      {tunes.map((tune) => (
        <article class="tune-card" data-tune-card data-name={tune.name} data-kind={resourceKind(tune.href)}>
          <div>
            <a href={tune.href} target="_blank" rel="noopener noreferrer">{tune.name}</a>
            <p>{resourceLabel(tune.href)}</p>
          </div>
          <span class="rating-pill" data-rating-pill>unrated</span>
        </article>
      ))}
    </div>
    <p id="empty-library-message" class="empty-message" hidden>No tunes match that filter.</p>
  </div>
</section>

<section
  id="song-library"
  class="library"
  aria-labelledby="songs-heading"
  data-collapsed="true"
>
  <div class="library__top">
    <div>
      <p class="eyebrow">Songs</p>
      <h2 id="songs-heading">Song Library</h2>
    </div>
    <button
      id="song-library-toggle"
      class="library-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="song-library-content"
    >
      Show Library
    </button>
  </div>

  <div id="song-library-content" class="library__content">
    <div class="library__tools">
      <input id="song-search" type="search" placeholder="Search songs" aria-label="Search songs" />
    </div>

    <div id="songs-list" class="tune-grid">
      {songs.map((song) => (
        <article class="tune-card" data-song-card data-name={song.name}>
          <div>
            <a href={song.href} target="_blank" rel="noopener noreferrer">{song.name}</a>
            <p>{song.pdfs.length} PDFs</p>
          </div>
          <span class="rating-pill rating-pill--neutral">{song.pdfs.length} charts</span>
        </article>
      ))}
    </div>
    <p id="empty-song-library-message" class="empty-message" hidden>No songs match that search.</p>
  </div>
</section>

<section class="utility-grid" aria-label="Practice resources">
  <article class="panel">
    <div class="panel__header">
      <h2>Backing Tracks</h2>
      <span>{backingTracks.length}</span>
    </div>
    <div class="track-buttons">
      {backingTracks.map((track) => <a class="track-button" href={track.href}>{track.name}</a>)}
    </div>
  </article>

  <article class="panel">
    <div class="panel__header">
      <h2>Transcriptions</h2>
      <span>{transcriptions.length}</span>
    </div>
    <div class="link-stack">
      {transcriptions.map((transcription) => (
        <a href={transcription.href}>
          <span>{transcription.name}</span>
          <small>{resourceLabel(transcription.href)}</small>
        </a>
      ))}
    </div>
  </article>
</section>

<section class="practice-history" aria-labelledby="practice-history-heading">
  <div class="panel practice-history__panel">
    <div class="panel__header">
      <h2 id="practice-history-heading">Practice History</h2>
      <span id="practice-history-count">0 days</span>
    </div>
    <div class="practice-history__calendar-wrap">
      <div class="practice-history__grid">
        <div class="practice-history__corner" aria-hidden="true"></div>
        <div id="practice-history-months" class="practice-history__months" aria-hidden="true"></div>
        <div class="practice-history__weekdays" aria-hidden="true">
          <span>Mon</span>
          <span>Wed</span>
          <span>Fri</span>
        </div>
        <div id="practice-history-calendar" class="practice-history__calendar" aria-label="Practice calendar"></div>
      </div>
    </div>
  </div>
</section>

<div class="page-reset">
  <button id="tune-trainer-reset" class="page-reset__button" type="button">Reset Practice Data</button>
</div>

<script>
  const storageKey = "pkapt-tune-trainer-ratings-v1";
  const practiceHistoryKey = "pkapt-practice-history-v1";
  const libraryModeKey = "pkapt-library-mode-v1";
  const libraryModeSelect = document.getElementById("library-mode") as HTMLSelectElement | null;
  const pageTitle = document.getElementById("page-title");
  const library = document.getElementById("tune-library");
  const searchInput = document.getElementById("tune-search") as HTMLInputElement | null;
  const libraryToggle = document.getElementById("library-toggle") as HTMLButtonElement | null;
  const songLibrary = document.getElementById("song-library");
  const songSearchInput = document.getElementById("song-search") as HTMLInputElement | null;
  const songLibraryToggle = document.getElementById("song-library-toggle") as HTMLButtonElement | null;
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-tune-card]"));
  const songCards = Array.from(document.querySelectorAll<HTMLElement>("[data-song-card]"));
  const emptyMessage = document.getElementById("empty-library-message");
  const emptySongMessage = document.getElementById("empty-song-library-message");
  const practiceHistoryCalendar = document.getElementById("practice-history-calendar");
  const practiceHistoryMonths = document.getElementById("practice-history-months");
  const practiceHistoryCount = document.getElementById("practice-history-count");
  let activeFilter = "all";

  function loadLibraryMode() {
    try {
      const saved = localStorage.getItem(libraryModeKey);
      return saved === "tunes" ? "tunes" : "songs";
    } catch {
      return "songs";
    }
  }

  function saveLibraryMode(mode: "songs" | "tunes") {
    localStorage.setItem(libraryModeKey, mode);
  }

  function applyLibraryMode(mode: "songs" | "tunes") {
    if (libraryModeSelect) libraryModeSelect.value = mode;
    document.title = mode === "songs" ? "Songs" : "Tunes";

    if (pageTitle) pageTitle.textContent = mode === "songs" ? "Songs" : "Tunes";
    window.dispatchEvent(new CustomEvent("library-mode-changed", { detail: { mode } }));
  }

  function setLibraryOpen(section: HTMLElement | null, toggle: HTMLButtonElement | null, isOpen: boolean) {
    if (section) section.dataset.collapsed = isOpen ? "false" : "true";
    if (toggle) {
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.textContent = isOpen ? "Hide Library" : "Show Library";
    }
  }

  function loadRatings(): Record<string, number> {
    try {
      return JSON.parse(localStorage.getItem(storageKey) ?? "{}");
    } catch {
      return {};
    }
  }

  function labelForRating(rating?: number) {
    if (rating === 1) return "good";
    if (rating === 2) return "ok";
    if (rating === 3) return "needs work";
    return "unrated";
  }

  function formatPracticeDate(date: Date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }

  function loadPracticeHistory() {
    try {
      const saved = JSON.parse(localStorage.getItem(practiceHistoryKey) ?? "[]");
      if (!Array.isArray(saved)) return [];
      return saved.filter((value, index) => typeof value === "string" && saved.indexOf(value) === index).sort();
    } catch {
      return [];
    }
  }

  function savePracticeHistory(days: string[]) {
    localStorage.setItem(practiceHistoryKey, JSON.stringify(days));
    renderPracticeHistory();
    window.dispatchEvent(new CustomEvent("practice-history-changed"));
  }

  function markTodayPracticed() {
    const today = formatPracticeDate(new Date());
    const history = loadPracticeHistory();
    if (history.includes(today)) return;
    savePracticeHistory([...history, today].sort());
  }

  function renderPracticeHistory() {
    if (!practiceHistoryCalendar || !practiceHistoryMonths || !practiceHistoryCount) return;

    const history = new Set(loadPracticeHistory());
    const totalDays = history.size;
    practiceHistoryCount.textContent = `${totalDays} day${totalDays === 1 ? "" : "s"}`;

    const weeks = 18;
    const today = new Date();
    const end = new Date(today);
    const dayOfWeek = end.getDay();
    end.setDate(end.getDate() - dayOfWeek);
    const start = new Date(end);
    start.setDate(end.getDate() - ((weeks * 7) - 1));

    const monthLabels: string[] = [];
    const weekColumns: string[] = [];

    for (let week = 0; week < weeks; week += 1) {
      const weekStart = new Date(start);
      weekStart.setDate(start.getDate() + (week * 7));
      const monthLabel = weekStart.toLocaleString("en-US", { month: "short" });
      const prevWeek = new Date(weekStart);
      prevWeek.setDate(weekStart.getDate() - 7);
      monthLabels.push(
        week === 0 || prevWeek.getMonth() !== weekStart.getMonth()
          ? `<span>${monthLabel}</span>`
          : "<span></span>"
      );

      const cells: string[] = [];
      for (let weekday = 0; weekday < 7; weekday += 1) {
        const current = new Date(weekStart);
        current.setDate(weekStart.getDate() + weekday);
        const key = formatPracticeDate(current);
        const practiced = history.has(key);
        const isFuture = current > today;
        const title = `${current.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric"
        })}${practiced ? ": practiced" : ": no practice logged"}`;
        cells.push(
          `<span class="practice-history__day${practiced ? " is-practiced" : ""}${isFuture ? " is-future" : ""}" title="${title}" aria-label="${title}"></span>`
        );
      }

      weekColumns.push(`<div class="practice-history__week">${cells.join("")}</div>`);
    }

    practiceHistoryMonths.innerHTML = monthLabels.join("");
    practiceHistoryCalendar.innerHTML = weekColumns.join("");
  }

  function syncLibrary() {
    const ratings = loadRatings();
    const query = searchInput?.value.trim().toLowerCase() ?? "";
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.dataset.name ?? "";
      const rating = ratings[name];
      const matchesSearch = name.toLowerCase().includes(query);
      const matchesFilter =
        activeFilter === "all" ||
        (activeFilter === "unrated" && !rating) ||
        String(rating) === activeFilter;

      const pill = card.querySelector<HTMLElement>("[data-rating-pill]");
      if (pill) {
        pill.textContent = labelForRating(rating);
        pill.dataset.rating = rating ? String(rating) : "unrated";
      }

      card.dataset.rating = rating ? String(rating) : "unrated";
      card.hidden = !(matchesSearch && matchesFilter);
      if (!card.hidden) visibleCount += 1;
    });

    if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
  }

  function syncSongLibrary() {
    const query = songSearchInput?.value.trim().toLowerCase() ?? "";
    let visibleCount = 0;

    songCards.forEach((card) => {
      const name = card.dataset.name ?? "";
      const matchesSearch = name.toLowerCase().includes(query);
      card.hidden = !matchesSearch;
      if (!card.hidden) visibleCount += 1;
    });

    if (emptySongMessage) emptySongMessage.hidden = visibleCount > 0;
  }

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeFilter = button.dataset.filter ?? "all";
      filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      syncLibrary();
    });
  });

  searchInput?.addEventListener("input", syncLibrary);
  songSearchInput?.addEventListener("input", syncSongLibrary);
  libraryModeSelect?.addEventListener("change", () => {
    const mode = libraryModeSelect.value === "tunes" ? "tunes" : "songs";
    saveLibraryMode(mode);
    applyLibraryMode(mode);
  });
  libraryToggle?.addEventListener("click", () => {
    const isOpen = libraryToggle.getAttribute("aria-expanded") === "true";
    setLibraryOpen(library, libraryToggle, !isOpen);
  });
  songLibraryToggle?.addEventListener("click", () => {
    const isOpen = songLibraryToggle.getAttribute("aria-expanded") === "true";
    setLibraryOpen(songLibrary, songLibraryToggle, !isOpen);
  });
  window.addEventListener("tune-ratings-changed", syncLibrary);
  window.addEventListener("tune-practiced", markTodayPracticed);
  window.addEventListener("practice-history-changed", renderPracticeHistory);
  setLibraryOpen(library, libraryToggle, false);
  setLibraryOpen(songLibrary, songLibraryToggle, false);
  syncLibrary();
  syncSongLibrary();
  renderPracticeHistory();
  applyLibraryMode(loadLibraryMode());
</script>

<style>
  .hero {
    margin-bottom: 1.25rem;
  }

  .panel,
  .library {
    background: rgba(18, 27, 21, 0.82);
    border: 1px solid rgba(214, 237, 218, 0.13);
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(14px);
  }

  .utility-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin: 1rem 0;
  }

  .hero__title-row {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1rem;
  }

  .hero__select-wrap {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }

  .hero__select-label {
    color: #a7b8a9;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__select {
    appearance: none;
    background: rgba(6, 12, 9, 0.72);
    border: 1px solid rgba(214, 237, 218, 0.18);
    border-radius: 8px;
    color: #f2f4ea;
    cursor: pointer;
    min-width: 9rem;
    padding: 0.6rem 2.2rem 0.6rem 0.8rem;
  }

  .practice-history {
    margin: 0 0 1rem;
  }

  .practice-history__panel {
    background: #0d1117;
    border: 1px solid #30363d;
    box-shadow: none;
    padding: 1rem;
  }

  .practice-history__calendar-wrap {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 1rem;
    overflow-x: auto;
    padding: 0.8rem;
  }

  .practice-history__grid {
    column-gap: 0.45rem;
    display: grid;
    grid-template-columns: 2.2rem max-content;
    grid-template-rows: auto auto;
    row-gap: 0.35rem;
    width: max-content;
  }

  .practice-history__corner {
    grid-column: 1;
    grid-row: 1;
  }

  .practice-history__months {
    color: #8b949e;
    column-gap: 0.25rem;
    display: grid;
    font-size: 0.7rem;
    font-weight: 500;
    grid-column: 2;
    grid-row: 1;
    grid-template-columns: repeat(18, 0.9rem);
    justify-content: start;
    line-height: 1;
  }

  .practice-history__weekdays {
    color: #8b949e;
    display: grid;
    font-size: 0.68rem;
    font-weight: 500;
    grid-column: 1;
    grid-row: 2;
    grid-template-rows: repeat(7, 0.9rem);
    line-height: 0.9rem;
    row-gap: 0.25rem;
  }

  .practice-history__weekdays span:nth-child(1) {
    grid-row: 2;
  }

  .practice-history__weekdays span:nth-child(2) {
    grid-row: 4;
  }

  .practice-history__weekdays span:nth-child(3) {
    grid-row: 6;
  }

  .practice-history__calendar {
    background: #0d1117;
    column-gap: 0.25rem;
    display: flex;
    grid-column: 2;
    grid-row: 2;
    justify-content: flex-start;
  }

  .practice-history__week {
    display: grid;
    gap: 0.25rem;
    grid-template-rows: repeat(7, 0.9rem);
  }

  .practice-history__day {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 2px;
    display: block;
    height: 0.9rem;
    width: 0.9rem;
  }

  .practice-history__day.is-practiced {
    background: #2ea043;
    border-color: #2ea043;
  }

  .practice-history__day.is-future {
    background: #0f141b;
    border-color: #1b2128;
  }

  .practice-history .panel__header h2 {
    font-size: 1rem;
  }

  .practice-history .panel__header span {
    background: transparent;
    border-radius: 0;
    color: #c9d1d9;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0;
  }

  .page-reset {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 1rem;
  }

  .page-reset__button {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(214, 237, 218, 0.16);
    border-radius: 7px;
    color: #d4e3d2;
    cursor: pointer;
    font-weight: 800;
    min-height: 2.7rem;
    min-width: 10rem;
    padding: 0.55rem 0.9rem;
  }

  .page-reset__button:hover {
    background: rgba(136, 219, 165, 0.1);
    border-color: rgba(30, 104, 77, 0.42);
  }

  .panel,
  .library {
    border-radius: 8px;
    padding: 1rem;
  }

  .panel__header,
  .library__top {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .panel__header span {
    background: rgba(136, 219, 165, 0.14);
    border-radius: 999px;
    color: #a4e6ba;
    font-size: 0.82rem;
    font-weight: 750;
    padding: 0.22rem 0.55rem;
  }

  .track-buttons {
    display: grid;
    gap: 0.55rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .track-button,
  .link-stack a {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(214, 237, 218, 0.12);
    border-radius: 7px;
    color: #ecf4e8;
    font-weight: 700;
    padding: 0.7rem;
    text-decoration: none;
  }

  .track-button:hover,
  .link-stack a:hover,
  .tune-card:hover {
    border-color: rgba(30, 104, 77, 0.42);
    background: rgba(136, 219, 165, 0.1);
    transform: translateY(-1px);
  }

  .link-stack {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .link-stack a {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .link-stack small {
    color: #a7b8a9;
    font-weight: 650;
  }

  .library {
    margin-top: 1rem;
  }

  .library__top {
    align-items: start;
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .library__tools {
    display: grid;
    gap: 0.7rem;
    width: 100%;
  }

  .library__content {
    display: grid;
    gap: 1rem;
  }

  .library[data-collapsed="true"] .library__content {
    display: none;
  }

  .library-toggle {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(214, 237, 218, 0.14);
    border-radius: 999px;
    color: #d4e3d2;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.5rem 0.8rem;
  }

  .library-toggle:hover {
    background: rgba(136, 219, 165, 0.1);
    border-color: rgba(30, 104, 77, 0.42);
  }

  #tune-search {
    background: rgba(6, 12, 9, 0.72);
    border: 1px solid rgba(214, 237, 218, 0.18);
    border-radius: 8px;
    color: #f2f4ea;
    padding: 0.7rem 0.8rem;
    width: 100%;
  }

  #tune-search::placeholder {
    color: #89988d;
  }

  #song-search {
    background: rgba(6, 12, 9, 0.72);
    border: 1px solid rgba(214, 237, 218, 0.18);
    border-radius: 8px;
    color: #f2f4ea;
    padding: 0.7rem 0.8rem;
    width: 100%;
  }

  #song-search::placeholder {
    color: #89988d;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .filter-tabs button {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid transparent;
    border-radius: 999px;
    color: #c5d1c1;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 750;
    padding: 0.45rem 0.7rem;
  }

  .filter-tabs button.is-active {
    background: #8be0ad;
    color: #07110d;
  }

  .tune-grid {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: 1fr;
  }

  .tune-card {
    align-items: center;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(214, 237, 218, 0.1);
    border-radius: 8px;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    min-height: 4.2rem;
    padding: 0.8rem;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .tune-card a {
    color: #f2f4ea;
    font-weight: 760;
    text-decoration: none;
  }

  .tune-card p {
    color: #95a499;
    font-size: 0.82rem;
    margin: 0.15rem 0 0;
    text-transform: capitalize;
  }

  .rating-pill {
    border-radius: 999px;
    flex: 0 0 auto;
    font-size: 0.74rem;
    font-weight: 800;
    padding: 0.32rem 0.52rem;
    text-transform: uppercase;
  }

  .rating-pill[data-rating="1"] {
    background: rgba(113, 217, 132, 0.18);
    color: #91eba0;
  }

  .rating-pill[data-rating="2"] {
    background: rgba(241, 199, 86, 0.18);
    color: #f0d076;
  }

